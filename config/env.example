# printq settings and secrets. Copy to ~/.config/printq/env, chmod 600, never commit.
PRINTQ_ORCA_BIN=orca-slicer

# Claude API key for the bed-check vision judge
PRINTQ_ANTHROPIC_API_KEY=

# The queue's own Telegram bot and the one chat it obeys (docs/operations.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional
#PRINTQ_AGENT_MODEL=gpt-oss:20b
#PRINTQ_OLLAMA_URL=http://localhost:11434
#PRINTQ_SHADOW_VISION_MODEL=ollama:gemma4:12b
#PRINTQ_SPOOLMAN_URL=http://spoolman/api/v1

# The print desk (`printq desk`): a local page where dropped, exported and slicer-sent files become jobs.
# PRINTQ_DESK_PORT=8766
# PRINTQ_DESK_BIND=127.0.0.1          # localhost only; the page has no login
# PRINTQ_DESK_WATCH=~/models/exports  # models written under here become drafts; the page opens by itself
# PRINTQ_DESK_OPEN=1                  # 0: never open a browser for a new export
# PRINTQ_DESK_KEY=                    # the slicer's "API key" for its print host; unset = slicer door closed
